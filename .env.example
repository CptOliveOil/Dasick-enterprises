# Command Centre — environment configuration.
#
# Copy to `.env.local` and fill in what you have. The application runs with an
# entirely empty file: with no database it uses a seeded in-memory dataset, and
# with no AI provider agents run on a simulated provider whose output is clearly
# labelled. Nothing is ever displayed as connected unless it genuinely is.
#
# Never commit `.env.local`. Only NEXT_PUBLIC_* values reach the browser.

# ---------------------------------------------------------------------------
# Database and authentication (Supabase)
#
# Set both of these to switch off demo mode. Then apply every file in
# supabase/migrations in order (0001 → 0012). Settings → Status names any
# migration the database is missing.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses Row Level Security — used for trusted background work.
# Leave blank unless you need it.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# AI providers
#
# Anthropic is the primary provider. Without a key the workforce still runs,
# on the simulated provider.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Optional alternatives. Adapters live in lib/integrations/ai.
OPENAI_API_KEY=
GOOGLE_AI_API_KEY=

# ---------------------------------------------------------------------------
# Platform integrations
#
# Until these are set, analytics screens show only recorded data and say so,
# and nothing can be published.
# ---------------------------------------------------------------------------
YOUTUBE_API_KEY=
ETSY_API_KEY=

# YouTube upload and analytics (official Data + Analytics APIs, OAuth).
# All three are needed for either. Uploads are private unless the operator
# chooses otherwise, and only happen after final approval.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# ---------------------------------------------------------------------------
# Media generation
#
# Provider-agnostic. Set both variables for a provider. Adapters that exist:
#   VOICE_PROVIDER=elevenlabs   (VOICE_PROVIDER_API_KEY = ElevenLabs key)
#   IMAGE_PROVIDER=openai       (IMAGE_PROVIDER_API_KEY = OpenAI key)
#   STOCK_PROVIDER=openverse    (no key needed)
# Optional tuning: VOICE_ID (default narrator voice), VOICE_MODEL,
# IMAGE_MODEL, YOUTUBE_CATEGORY_ID.
# Any other name with a key set is refused loudly — there is no adapter.
# Without a provider the production pipeline stops at that step and says which
# provider is missing — it never fakes an asset in a real workspace.
#
# All of these are called server-side only. No media key reaches the browser.
# ---------------------------------------------------------------------------
VOICE_PROVIDER=
VOICE_PROVIDER_API_KEY=
IMAGE_PROVIDER=
IMAGE_PROVIDER_API_KEY=
VIDEO_PROVIDER=
VIDEO_PROVIDER_API_KEY=

# Stock footage and stills (search-and-licence, not generation). Only licensed
# libraries — nothing scrapes copyrighted commercial media.
STOCK_PROVIDER=
STOCK_PROVIDER_API_KEY=

# ---------------------------------------------------------------------------
# Rendering
#
# Video assembly runs locally through ffmpeg — no third-party render service and
# no spend. `ffmpeg-static` ships a binary and is used automatically; set this
# only to point at a different build.
# ---------------------------------------------------------------------------
FFMPEG_PATH=

# ---------------------------------------------------------------------------
# Simulation
#
# In demo mode, missing media providers stand in with placeholder assets that
# are stored with `simulated: true`, badged SIMULATED throughout the UI and
# never given a public URL. Set this to `true` to switch that off, so those
# steps block instead. Simulation is never available outside demo mode.
# ---------------------------------------------------------------------------
DISABLE_SIMULATED_MEDIA=

# Optional override of the inferred mode (demo without Supabase, production
# with it). "development" = real database and real Claude, but media providers
# may be simulated (badged). Leave blank for production behaviour.
COMMAND_CENTRE_MODE=

# ---------------------------------------------------------------------------
# Display
# ---------------------------------------------------------------------------
DEFAULT_CURRENCY=GBP
