# Command Centre — environment configuration.
#
# Copy to `.env.local` and fill in what you have. The application runs with an
# entirely empty file: with no database it uses a seeded in-memory dataset, and
# with no AI provider agents run on a simulated provider whose output is clearly
# labelled. Nothing is ever displayed as connected unless it genuinely is.
#
# Never commit `.env.local`. Only NEXT_PUBLIC_* values reach the browser.

# ---------------------------------------------------------------------------
# Database and authentication (Supabase)
#
# Set both of these to switch off demo mode. Then run the migration in
# supabase/migrations/0001_initial_schema.sql against your project.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses Row Level Security — used for trusted background work.
# Leave blank unless you need it.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# AI providers
#
# Anthropic is the primary provider. Without a key the workforce still runs,
# on the simulated provider.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Optional alternatives. Adapters live in lib/integrations/ai.
OPENAI_API_KEY=
GOOGLE_AI_API_KEY=

# ---------------------------------------------------------------------------
# Platform integrations
#
# Until these are set, analytics screens show only recorded data and say so,
# and nothing can be published.
# ---------------------------------------------------------------------------
YOUTUBE_API_KEY=
ETSY_API_KEY=

# ---------------------------------------------------------------------------
# Media generation
#
# Provider-agnostic. Implement the matching interface in
# lib/integrations/media.ts and set both variables for a provider.
# ---------------------------------------------------------------------------
VOICE_PROVIDER=
VOICE_PROVIDER_API_KEY=
IMAGE_PROVIDER=
IMAGE_PROVIDER_API_KEY=
VIDEO_PROVIDER=
VIDEO_PROVIDER_API_KEY=

# ---------------------------------------------------------------------------
# Display
# ---------------------------------------------------------------------------
DEFAULT_CURRENCY=GBP
